{
  "name": "congressional-app-challenge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm:dev:web\" \"npm:server\"",
    "dev:web": "vite",
    "server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test server/*.test.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "emulators": "firebase emulators:start --only auth,firestore"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "express": "^5.2.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
