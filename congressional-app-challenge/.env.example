# Copy to .env and fill in. .env is gitignored — never commit a real key.

# ─────────────────────────────────────────────────────────────
# Firebase — client (browser)
# ─────────────────────────────────────────────────────────────
# From Firebase console → Project settings → Your apps → Web app → SDK setup.
#
# These are NOT secrets. Firebase web config is public by design — it names
# your project, it doesn't grant access. What protects your data is
# Authentication plus firestore.rules. Anything VITE_ is bundled into the
# browser, so never put a real secret behind that prefix.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to point the app at the local emulator suite instead of your
# real project. Requires Java: `npm run emulators`.
VITE_FIREBASE_EMULATOR=false

# ─────────────────────────────────────────────────────────────
# Firebase — server (Admin SDK)
# ─────────────────────────────────────────────────────────────
# THIS ONE IS A REAL SECRET. The Admin SDK ignores firestore.rules entirely,
# so this key can read and write everything. Server-only, never VITE_.
#
# Firebase console → Project settings → Service accounts → Generate new
# private key. Paste the whole JSON file on one line, in single quotes.
FIREBASE_SERVICE_ACCOUNT=

# Alternative to the above: a path to the downloaded JSON key file.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Needed only when using the emulator or a credentials file.
FIREBASE_PROJECT_ID=

# ─────────────────────────────────────────────────────────────
# Checkr
# ─────────────────────────────────────────────────────────────
# Secret API key from the Checkr dashboard (Account > Developer Settings).
# Server-only. It must never appear in src/ or any client bundle.
CHECKR_API_KEY=

# "staging" (default) or "production".
#   staging    -> https://api.checkr-staging.com/v1   (test keys, no real people screened)
#   production -> https://api.checkr.com/v1           (real screenings, real money)
CHECKR_ENVIRONMENT=staging

# Screening package slug. Package slugs are account-specific — check
# Account > Packages in the Checkr dashboard for the ones you can order.
CHECKR_PACKAGE=tasker_standard

# Optional: point at a different Checkr host. Overrides CHECKR_ENVIRONMENT.
# Used by the test double to exercise the integration without credentials.
# CHECKR_API_BASE_URL=

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
# Port for the TeenHands API server. Vite proxies /api here in dev.
PORT=8787
