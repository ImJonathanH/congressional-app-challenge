# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Secret API key from the Checkr dashboard (Account > Developer Settings).
# This is server-only. It must never appear in src/ or any client bundle.
CHECKR_API_KEY=

# "staging" (default) or "production".
#   staging    -> https://api.checkr-staging.com/v1   (test keys, no real people screened)
#   production -> https://api.checkr.com/v1           (real screenings, real money)
CHECKR_ENVIRONMENT=staging

# Screening package slug. Package slugs are account-specific — check
# Account > Packages in the Checkr dashboard for the ones you can order.
CHECKR_PACKAGE=tasker_standard

# Port for the TeenHands API server. Vite proxies /api here in dev.
PORT=8787

# Optional: point at a different Checkr host. Overrides CHECKR_ENVIRONMENT.
# Used by the test double in server/__tests__ to exercise the integration
# without real credentials.
# CHECKR_API_BASE_URL=
